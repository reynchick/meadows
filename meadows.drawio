  <diagram name="Copy of Class Diagram" id="OD6wlJaA04VgcaFqUfi_">
    <mxGraphModel dx="11250" dy="7347" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" background="none" math="0" shadow="0">
      <root>
        <mxCell id="kQyaeERVCVtOx3rxXlmn-0" />
        <mxCell id="kQyaeERVCVtOx3rxXlmn-1" parent="kQyaeERVCVtOx3rxXlmn-0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho  &#39; Ensures straight lines\n\n&#39; =======================\n&#39; Abstract Classes (Inheritance)\n&#39; =======================\nabstract class Staff {\n  - staffID: int\n  - fName: String\n  - lName: String\n  - address: String\n  - telephone: String\n  - dateOfBirth: Date\n  - sex: String\n  - nationalInsuranceNumber: String\n  - role: String\n  - currentSalary: Float\n  - salaryScale: String\n  - contractType: String\n  - hoursPerWeek: Integer\n  - paymentType: String\n\n  + updateStaffDetails(newAddress: String, newPhone: String, newSalary: Float): void\n  + assignToWard(wardID: String): void\n  + getStaffSchedule(): List&lt;Appointment&gt;\n}\n\nclass StaffQualification {\n  - qualificationID: int\n  - qualificationType: String\n  - institution: String\n  - dateOfQualification: Date\n\n+ addQualification(staffID: String, qualificationType: String, institution: String, dateOfQualification: Date): void\n  + updateQualification(qualificationID: String, newType: String, newInstitution: String, newDate: Date): void\n  + removeQualification(qualificationID: String): void\n}\n\nclass StaffExperience {\n  - experienceID: int\n  - organization: String\n  - position: String\n  - startDate: Date\n  - endDate: Date\n\n+ addExperience(staffID: String, organization: String, position: String, startDate: Date, endDate: Date): void\n  + updateExperience(experienceID: String, newPosition: String, newStartDate: Date, newEndDate: Date): void\n  + removeExperience(experienceID: String): void\n}\n\nclass MedicalDirector {\n  + allocateHospitalResources(): void\n  + approveBudgets(): void\n}\n\nclass ChargeNurse {\n  - budgetAllocated: Float\n  + approveWardRequisition(requisitionID: String): void\n  + manageWardBudget(amount: Float): void\n}\n\nclass SeniorNurse {\n  + superviseJuniorNurses(): void\n  + administerMedication(patientID: String, medicationID: String): void\n}\n\nclass JuniorNurse {\n  + assistSeniorNurse(): void\n  + monitorPatient(patientID: String): void\n}\n\nStaff &lt;|-- MedicalDirector\nStaff &lt;|-- ChargeNurse\nStaff &lt;|-- SeniorNurse\nStaff &lt;|-- JuniorNurse\nStaff *-- StaffQualification\nStaff *-- StaffExperience\nStaff o-- WardRequisition\n\nabstract class Patient {\n  - patientID: int\n  - fName: String\n  - lName: String\n  - patientType: String\n  - address: String\n  - phone: String\n  - dateOfBirth: Date\n  - sex: String\n  - maritalStatus: String\n  - dateRegistered: Date\n\n  + registerPatient(): void\n  + updatePatientDetails(newAddress: String, newPhone: String): void\n  + getAppointments(): List&lt;Appointment&gt;\n  + getMedicationHistory(): List&lt;Medication&gt;\n}\n\nclass InPatient {\n  - datePlacedOnWaitlist: Date\n  - wardRequired: String\n  - expectedDaysToStay: Integer\n  - dateAdmittedInWard: Date\n  - expectedLeave: Date\n  - actualLeave: Date\n  + assignToWard(wardID: String): void\n  + assignBed(bedID: String): void\n  + dischargePatient(): void\n}\n\nInPatient o-- Bed\n\nclass OutPatient {\n  - appointmentDate: Date\n  - appointmentTime: String\n  + scheduleAppointment(appointmentDate: Date, doctorID: String): void\n  + getNextAppointment(): Appointment\n}\n\nPatient &lt;|-- InPatient\nPatient &lt;|-- OutPatient\n\nclass SurgNonSurgSupply {\n  - itemID: int\n  - supplyName: String\n  - description: String\n  - quantityInStock: int\n  - reorderLevel: int\n  - costPerUnit: Float\n\n  + updateStock(quantity: int): void\n  + reorderStock(reorderAmount: int): void\n  + checkExpiration(): Boolean\n}\n\nclass PharmaSupply {\n  - drugID: String\n  - drugName: String\n  - description: String\n  - dosage: String\n  - administrationMethod: String  &#39; (e.g., Oral, IV)\n  - quantityInStock: int\n  - reorderLevel: int\n  - costPerUnit: Float\n\n  + updateStock(quantity: int): void\n  + reorderStock(reorderAmount: int): void\n  + checkDrugInteractions(drugID: String): List&lt;String&gt;\n  + verifyDosageSafety(patientAge: int, weight: Float): Boolean\n}\n\nclass SupplierSupplies {\n  - supplyID: String\n\n+ addSupplyToSupplier(supplierID: String, supplyID: String): void\n  + removeSupplyFromSupplier(supplierID: String, supplyID: String): void\n  + getSuppliesBySupplier(supplierID: String): List&lt;String&gt;\n}\n\nSupplier o-- SupplierSupplies\nSupplierSupplies o-- SurgNonSurgSupply\nSupplierSupplies o-- PharmaSupply\n\n&#39; =======================\n&#39; Core Entities\n&#39; =======================\nclass Ward {\n  - wardID: String\n  - wardName: String\n  - location: String\n  - totalBeds: Integer\n  - telExtension: String\n\n  + assignChargeNurse(nurseID: String): void\n  + getAvailableBeds(): List&lt;Bed&gt;\n  + updateWardDetails(newLocation: String, newTelExtension: String): void\n}\n\nWard o-- ChargeNurse\n\nclass Bed {\n  - bedID: String\n\n+ assignToPatient(patientID: String): void\n  + markAsOccupied(): void\n  + markAsVacant(): void\n}\n\nclass NextOfKin {\n  - name: String\n  - relationship: String\n  - address: String\n  - phone: String\n\n  + updateNextOfKinDetails(newAddress: String, newPhone: String): void\n}\n\nclass LocalDoctor {\n  - clinicID: String\n  - name: String\n  - address: String\n  - phone: String\n\n  + referPatient(patientID: String, hospitalID: String): void\n}\n\nclass PatientAppointment {\n  - appointmentID: String\n  - patientID: String\n  - staffID: String\n  - appointmentDate: Date\n  - appointmentTime: String\n  - examinationRoom: String\n  - appointmentOutcome: String\n\n  + scheduleAppointment(patientID: String, doctorID: String, appointmentDate: Date, room: String): void\n  + updateAppointment(newDate: Date, newRoom: String): void\n  + cancelAppointment(): void\n}\n\nclass Medication {\n  - medicationID: String\n  - unitsPerDay: Integer\n  - administrationMethod: String\n  - startDate: Date\n  - endDate: Date\n\n+ prescribeMedication(patientID: String, drugID: String, unitsPerDay: int, administrationMethod: String, startDate: Date, endDate: Date): void\n  + updateMedication(medicationID: String, newUnitsPerDay: int, newEndDate: Date): void\n  + discontinueMedication(medicationID: String): void\n}\n\nclass Supplier {\n  - supplierID: String\n  - supplierName: String\n  - address: String\n  - telephone: String\n  - fax: String\n\n  + updateSupplierDetails(newAddress: String, newPhone: String): void\n  + addSupply(supplyID: String): void\n}\n\nclass WardRequisition {\n  - requisitionID: String\n  - dateOrdered: Date\n  - dateReceived: Date\n  - itemID: int\n  - drugID: int\n\n  + createRequisition(staffID: String, wardID: String, items: List&lt;Supply&gt;): void\n  + approveRequisition(): void\n  + markAsReceived(): void\n}\n\nclass WardRequisitionItem {\n  - requisitionItemID: String\n  - quantityRequired: int\n  - costPerUnit: Float\n\n+ addItemToRequisition(requisitionID: String, supplyID: String, quantity: int, costPerUnit: Float): void\n  + updateItemQuantity(requisitionItemID: String, newQuantity: int): void\n  + removeItemFromRequisition(requisitionItemID: String): void\n}\n\nWardRequisition o-- WardRequisitionItem\nWardRequisitionItem o-- SurgNonSurgSupply\nWardRequisitionItem o-- PharmaSupply\n\n&#39; =======================\n&#39; Relationships\n&#39; =======================\n\n&#39; Aggregation (Hollow Diamond)\nWard o-- Staff\nWard o-- InPatient\nWard o-- WardRequisition\n\nPatient o-- LocalDoctor\nPatient o-- PatientAppointment\nPatient o-- Medication\n\nWardRequisition o-- PharmaSupply\nWardRequisition o-- SurgNonSurgSupply\n\nSupplier o-- PharmaSupply\nSupplier o-- SurgNonSurgSupply\n\n&#39; Composition (Solid Diamond)\nWard *-- Bed\nPatient *-- NextOfKin\n\n&#39; Association/Aggregation Classes\nPatientAppointment -- Staff\n\nMedication -- PharmaSupply\n\n&#39; Dependency Relationships (Dashed Arrow)\nWardRequisition ..&gt; ChargeNurse\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="kQyaeERVCVtOx3rxXlmn-82">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="kQyaeERVCVtOx3rxXlmn-1">
            <mxGeometry x="-3970" y="-2490" width="4502" height="1606" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
