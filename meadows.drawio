        <mxCell id="GB_4NPN2bPyYWb5Kk_4b-5" value="+ method(type): type" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" parent="GB_4NPN2bPyYWb5Kk_4b-2" vertex="1">
