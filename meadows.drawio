        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho  &#39; Forces straight lines\n\n&#39; =======================\n&#39; Abstract Classes (Inheritance)\n&#39; =======================\nabstract class Staff {\n  - staffID: String\n  - firstName: String\n  - lastName: String\n  - address: String\n  - telephone: String\n  - dateOfBirth: Date\n  - sex: String\n  - role: String\n  - salary: Float\n  - contractType: String\n  - qualifications: List&lt;Qualification&gt;\n  - workExperience: List&lt;WorkExperience&gt;\n}\n\nStaff &lt;|-- MedicalDirector\nStaff &lt;|-- ChargeNurse\nStaff &lt;|-- SeniorNurse\nStaff &lt;|-- JuniorNurse\n\nabstract class Patient {\n  - patientID: String\n  - firstName: String\n  - lastName: String\n  - address: String\n  - phone: String\n  - dateOfBirth: Date\n  - sex: String\n  - maritalStatus: String\n}\n\nPatient &lt;|-- InPatient\nPatient &lt;|-- OutPatient\n\n&#39; =======================\n&#39; Core Entities\n&#39; =======================\nclass Ward {\n  - wardID: String\n  - wardName: String\n  - location: String\n  - totalBeds: Integer\n  - telExtension: String\n  - chargeNurseID: String\n}\n\nclass Bed {\n  - bedID: String\n  - wardID: String\n  - isOccupied: Boolean\n}\n\nclass PatientNextOfKin {\n  - name: String\n  - relationship: String\n  - address: String\n  - phone: String\n}\n\nclass LocalDoctor {\n  - clinicID: String\n  - fullName: String\n  - address: String\n  - phone: String\n}\n\nclass Appointment {\n  - appointmentID: String\n  - patientID: String\n  - staffID: String\n  - appointmentDate: Date\n  - roomNumber: String\n  - status: String\n}\n\nclass Medication {\n  - medicationID: String\n  - patientID: String\n  - drugID: String\n  - dosage: String\n  - administrationMethod: String\n  - startDate: Date\n  - endDate: Date\n}\n\nclass Supplier {\n  - supplierID: String\n  - name: String\n  - address: String\n  - phone: String\n  - fax: String\n}\n\nclass Supply {\n  - supplyID: String\n  - name: String\n  - description: String\n  - quantityInStock: Integer\n  - reorderLevel: Integer\n  - costPerUnit: Float\n  - category: String\n}\n\nclass WardRequisition {\n  - requisitionID: String\n  - wardID: String\n  - staffIDPlacingReq: String\n  - approvedBy: String\n  - dateOrdered: Date\n  - itemsOrdered: List&lt;Supply&gt;\n}\n\n&#39; =======================\n&#39; Relationships (Now Using Straight Lines)\n&#39; =======================\n\n&#39; Aggregation (Hollow Diamond ⚪—◇)\nWard o-- ChargeNurse\nWard o-- Staff\nWard o-- InPatient\nWard o-- WardRequisition\n\nPatient o-- LocalDoctor\nPatient o-- Appointment\nPatient o-- Medication\n\nSupplier o-- Supply\n\n&#39; Composition (Solid Diamond ⚫—◆)\nWard *-- Bed\nPatient *-- PatientNextOfKin\nWardRequisition *-- Supply\n\n&#39; Association Classes\nAppointment -- Patient\nAppointment -- Staff\n\nMedication -- Patient\nMedication -- Supply\n\n&#39; Dependency Relationships (Dashed Arrow ↘)\nWardRequisition ..&gt; ChargeNurse\nAppointment ..&gt; Patient\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="cWEdBYgVR222FMvErGeN-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="-80" y="990" width="1313" height="895" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
