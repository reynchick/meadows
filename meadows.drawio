        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam linetype ortho  &#39; Ensures straight lines\n\n&#39; =======================\n&#39; Abstract Classes (Inheritance)\n&#39; =======================\nabstract class Staff {\n  - staffID: int\n  - fName: String\n  - lName: String\n  - address: String\n  - telephone: String\n  - dateOfBirth: Date\n  - sex: String\n  - nationalInsuranceNumber: String\n  - role: String\n  - currentSalary: Float\n  - salaryScale: String\n  - contractType: String\n  - hoursPerWeek: Integer\n  - paymentType: String\n\n+ updateStaffDetails(newAddress: String, newPhone: String, newSalary: Float): void\n+ assignToWard(wardID: String): void\n+ getStaffSchedule(): List&lt;Appointment&gt;\n}\n\n\nclass Qualification {\n  - qualificationID: int\n  - qualificationType: String\n  - institution: String\n  - dateOfQualification: Date\n}\n\nclass WorkExperience {\n  - experienceID: int\n  - organization: String\n  - position: String\n  - startDate: Date\n  - endDate: Date\n}\n\nclass MedicalDirector {\n  + allocateHospitalResources(): void\n  + approveBudgets(): void\n}\n\nclass ChargeNurse {\n  - budgetAllocated: Float\n  + approveWardRequisition(requisitionID: String): void\n  + manageWardBudget(amount: Float): void\n}\n\nclass SeniorNurse {\n  + superviseJuniorNurses(): void\n  + administerMedication(patientID: String, medicationID: String): void\n}\n\nclass JuniorNurse {\n  + assistSeniorNurse(): void\n  + monitorPatient(patientID: String): void\n}\n\nStaff &lt;|-- MedicalDirector\nStaff &lt;|-- ChargeNurse\nStaff &lt;|-- SeniorNurse\nStaff &lt;|-- JuniorNurse\nStaff *-- Qualification\nStaff *-- WorkExperience\n\nabstract class Patient {\n  - patientID: int\n  - fName: varchar\n  - lName: varchar\n  - patientType: String\n  - address: String\n  - phone: String\n  - dateOfBirth: Date\n  - sex: String\n  - maritalStatus: String\n  - dateRegistered: Date\n\n+ registerPatient(): void\n+ updatePatientDetails(newAddress: String, newPhone: String): void\n+ getAppointments(): List&lt;Appointment&gt;\n+ getMedicationHistory(): List&lt;Medication&gt;\n\n}\n\nclass InPatient {\n - datePlacedOnWaitlist: Date\n  - wardRequired: String\n  - expectedDaysToStay: Integer\n   - dateAdmittedInWard: Date\n  - expectedLeave: Date\n  - actualLeave: Date\n  + assignToWard(wardID: String): void\n  + assignBed(bedID: String): void\n  + dischargePatient(): void\n}\n\nclass OutPatient {\n  - appointmentDate: Date\n  - appointmentTime: String\n  + scheduleAppointment(appointmentDate: Date, doctorID: String): void\n  + getNextAppointment(): Appointment\n}\n\n\nPatient &lt;|-- InPatient\nPatient &lt;|-- OutPatient\n\nclass SurgNonSurgSupply {\n  - itemID: int\n  - supplyName: String\n  - description: String\n  - quantityInStock: int\n  - reorderLevel: int\n  - costPerUnit: Float\n\n  + updateStock(quantity: int): void\n  + reorderStock(reorderAmount: int): void\n  + checkExpiration(): Boolean\n}\n\n\nclass PharmaSupply {\n  - drugID: String\n  - drugName: String\n  - description: String\n  - dosage: String\n  - administrationMethod: String  &#39; (e.g., Oral, IV)\n  - quantityInStock: int\n  - reorderLevel: int\n  - costPerUnit: Float\n\n  + updateStock(quantity: int): void\n  + reorderStock(reorderAmount: int): void\n  + checkDrugInteractions(drugID: String): List&lt;String&gt;\n  + verifyDosageSafety(patientAge: int, weight: Float): Boolean\n}\n\n\n\n&#39; =======================\n&#39; Core Entities\n&#39; =======================\nclass Ward {\n  - wardID: String\n  - wardName: String\n  - location: String\n  - totalBeds: Integer\n  - telExtension: String\n\n   + assignChargeNurse(nurseID: String): void \n   + getAvailableBeds(): List&lt;Bed&gt; \n   + updateWardDetails(newLocation: String, newTelExtension: String): void\n}\n\nWard o-- ChargeNurse\n\nclass Bed {\n  - bedID: String\n  - wardID: String\n  - isOccupied: Boolean\n}\n\nclass PatientNextOfKin {\n  - name: String\n  - relationship: String\n  - address: String\n  - phone: String\n\n+ updateNextOfKinDetails(newAddress: String, newPhone: String): void\n}\n\nclass LocalDoctor {\n  - clinicID: String\n  - name: String\n  - address: String\n  - phone: String\n\n+ referPatient(patientID: String, hospitalID: String): void\n\n}\n\nclass Appointment {\n  - appointmentID: String\n  - patientID: String\n  - staffID: String\n  - appointmentDate: Date\n  - appointmentTime: String\n  - examinationRoom: String\n  - appointmentOutcome: String\n\n+ scheduleAppointment(patientID: String, doctorID: String, appointmentDate: Date, room: String): void\n+ updateAppointment(newDate: Date, newRoom: String): void\n+ cancelAppointment(): void\n\n}\n\nclass Medication {\n  - medicationID: String\n  - patientID: String\n  - drugID: String\n  - unitsPerDay: Integer\n  - administrationMethod: String\n  - startDate: Date\n  - endDate: Date\n}\n\nclass Supplier {\n  - supplierID: String\n  - supplierName: String\n  - address: String\n  - telephone: String\n  - fax: String\n\n+ updateSupplierDetails(newAddress: String, newPhone: String): void\n+ addSupply(supplyID: String): void\n\n}\n\nclass WardRequisition {\n  - requisitionID: String\n  - staffIDPlacingReq: String\n  - wardID: String\n  - receivedBy: String\n  - dateOrdered: Date\n  - dateReceived: Date\n  - itemsOrdered: List&lt;Supply&gt;\n\n+ createRequisition(staffID: String, wardID: String, items: List&lt;Supply&gt;): void\n+ approveRequisition(): void\n+ markAsReceived(): void\n\n}\n\nclass Medication {\n  - medicationID: String\n  - patientID: String\n  - drugID: String\n  - unitsPerDay: Integer\n  - administrationMethod: String  &#39; (e.g., Oral, IV)\n  - startDate: Date\n  - endDate: Date\n\n  + prescribeMedication(patientID: String, drugID: String, dosage: Integer, administrationMethod: String): void\n  + updateMedication(newDosage: Integer, newEndDate: Date): void\n  + discontinueMedication(): void\n}\n\n\n&#39; =======================\n&#39; Relationships\n&#39; =======================\n\n&#39; Aggregation (Hollow Diamond)\nWard o-- ChargeNurse\nWard o-- Staff\nWard o-- InPatient\nWard o-- WardRequisition\n\nPatient o-- LocalDoctor\nPatient o-- Appointment\nPatient o-- Medication\n\nWardRequisition o-- Supply\n\nSupplier o-- Supply\n\n&#39; Composition (Solid Diamond)\nWard *-- Bed\nPatient *-- PatientNextOfKin\n\n&#39; Association Classes\nAppointment -- Patient\nAppointment -- Staff\n\nMedication -- Patient\nMedication -- Supply\n\n&#39; Dependency Relationships (Dashed Arrow)\nWardRequisition ..&gt; ChargeNurse\nAppointment ..&gt; Patient\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="I2W56WGQZ6LNwaM6MCy6-1">
